# Reference list of supported environment variables (all optional).
# Set them in your shell, e.g.  $env:DEMO_MODE = "1"  (PowerShell)  or  export DEMO_MODE=1  (bash).
# The app does not read .env files automatically.

# Force offline synthetic mode for every job (recommended for demos / reviewers)
DEMO_MODE=0

RASTERKIT_HOST=127.0.0.1
RASTERKIT_PORT=5000

# Override working directories (defaults: ./data and ./outputs/jobs)
# RASTERKIT_DATA_DIR=
# RASTERKIT_JOBS_DIR=

# Limits
# RASTERKIT_MAX_UPLOAD_MB=10
# RASTERKIT_MAX_FEATURES=500
# RASTERKIT_MAX_SCENES=12
